PORT=3000
#DB_ADDRESS=mongodb://root:example@mongo:27017/weblarek?authSource=admin - использовть эту переменную окружения, если запускаем в Docker
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek?authSource=admin
UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp
ORIGIN_ALLOW=http://localhost:5173
AUTH_REFRESH_TOKEN_EXPIRY=7d
AUTH_ACCESS_TOKEN_EXPIRY=10m

# Generate independent secrets of at least 32 characters for production.
# Development uses random process-local secrets when unset.
COOKIE_SECURE=false
# Exact trusted proxy IPs, comma-separated; empty for direct local development.
# docker-compose.yml configures the dedicated nginx address.
TRUSTED_PROXIES=

# Combined quota of temporary and permanent image files in bytes (256 MiB).
IMAGE_STORAGE_MAX_BYTES=268435456
